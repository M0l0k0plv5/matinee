#!/usr/bin/env python3
"""Signs Matinee in to Jellyfin, or with --navidrome to Navidrome. The password is used for this one login and
never stored: for Jellyfin Matinee only keeps the access token, which can be revoked under Dashboard → Devices;
for Navidrome md5(password + salt) and the salt, which the Subsonic API signs its requests with.
With --audiobookshelf it takes an API key instead (Audiobookshelf: Settings → Users → API keys) and keeps it.

    set-password              ask in the terminal (or, with no terminal, in a fuzzel prompt or a macOS dialog)
    set-password --clipboard  take it from the clipboard (Wayland, or macOS), e.g. after copying it from a password manager
    set-password --stdin      read it from standard input, e.g. `pass show jellyfin | ./set-password --stdin`
    set-password --navidrome  the same for Navidrome ("navidrome" in config.json), with any of the above
    set-password --audiobookshelf  the API key for Audiobookshelf ("audiobookshelf" in config.json), likewise

A running Matinee picks up the new login by itself.
"""
import getpass, subprocess, sys, urllib.error
from pathlib import Path

sys.dont_write_bytecode = True  # no __pycache__ next to the scripts
sys.path.insert(0, str(Path(__file__).resolve().parent))
from backend import core, jellyfin_api, services  # noqa: E402  (only reads the config, starts nothing)

NAVIDROME = "--navidrome" in sys.argv
AUDIOBOOKSHELF = "--audiobookshelf" in sys.argv
if NAVIDROME and not services.ND_SERVER:
    raise SystemExit('No Navidrome in config.json: add "navidrome": {"server": "…", "username": "…"} first.')
if AUDIOBOOKSHELF and not services.ABS_SERVER:
    raise SystemExit('No Audiobookshelf in config.json: add "audiobookshelf": {"server": "…"} first.')
if not NAVIDROME and not AUDIOBOOKSHELF and not (core.SERVER and core.conf.get("username")):
    raise SystemExit('No Jellyfin server yet: sign in on the TV (Movies & Shows), or add "server" and "username" to config.json first.')
prompt = (f"Navidrome password for {services.ND.get('username')}: " if NAVIDROME
          else "Audiobookshelf API key: " if AUDIOBOOKSHELF
          else f"Jellyfin password for {core.conf['username']}: ")
if "--clipboard" in sys.argv:
    paste = ["pbpaste"] if sys.platform == "darwin" else ["wl-paste", "--no-newline"]
    pw = subprocess.run(paste, capture_output=True, text=True).stdout.strip()
elif "--stdin" in sys.argv:
    pw = sys.stdin.readline().rstrip("\n")
elif sys.stdin.isatty():
    pw = getpass.getpass(prompt)
elif sys.platform == "darwin":  # no terminal on macOS: a dialog with a hidden field (Cancel leaves it empty)
    script = ('on run argv\ntext returned of (display dialog (item 1 of argv) default answer "" with hidden answer '
              'with title "Matinee")\nend run')
    r = subprocess.run(["osascript", "-e", script, prompt.rstrip(": ")], capture_output=True, text=True)
    pw = r.stdout.rstrip("\n")
else:  # no terminal (e.g. started from a launcher): ask graphically
    r = subprocess.run(["fuzzel", "--dmenu", "--password", "--lines=0", f"--prompt={prompt}"],
                       input="", capture_output=True, text=True)
    pw = r.stdout.rstrip("\n")
if not pw:
    raise SystemExit("Cancelled, nothing changed.")
if AUDIOBOOKSHELF:
    try:
        services.abs_authenticate(pw)
    except services.AbsError as e:
        raise SystemExit("API key rejected." if str(e) == "abs_auth_rejected" else "Audiobookshelf not reachable.")
    print("Matinee uses this API key for Audiobookshelf now.")
    raise SystemExit(0)
if NAVIDROME:
    try:
        services.nd_authenticate(pw)
    except services.NavidromeError as e:
        raise SystemExit("Login rejected: wrong user name or password." if str(e) == "nd_auth_rejected"
                         else "Navidrome not reachable.")
    print("Signed in to Navidrome. The password was not stored.")
    raise SystemExit(0)
try:
    jellyfin_api.authenticate(pw)
except urllib.error.HTTPError as e:
    raise SystemExit("Login rejected: wrong user name or password." if e.code == 401 else f"Jellyfin responded with {e.code}.")
except OSError as e:
    raise SystemExit("Jellyfin not reachable.")
jellyfin_api.forget_password()
print("Signed in. The password was not stored.")
