# Starts Matinee full screen on tty1 at boot (cage + Chromium), without a desktop.
# deploy/install.sh fills in the user and copies it to /etc/systemd/system.
[Unit]
Description=Matinee (media center for the TV)
# No waiting for the network: Matinee says "connecting" and signs in by itself once Jellyfin is reachable.
# The boot splash (deploy/boot.sh) stays up until cage draws: Matinee quits it, plymouth-quit must not.
# If Matinee fails to start, the splash goes away so the console can be seen: ExecStopPost below, not GDM's
# OnFailure= on plymouth-quit, which conflicts with this unit and so cancelled the start a restart had queued
# (systemctl restart from the nightly update, its stop timed out: Matinee left stopped until someone came)
After=systemd-user-sessions.service plymouth-start.service plymouth-quit.service
Conflicts=plymouth-quit.service
# tty1 is Matinee's: the console there makes way (getty, or kmscon on Fedora)
Conflicts=getty@tty1.service kmsconvt@tty1.service
After=getty@tty1.service kmsconvt@tty1.service

[Service]
User=@USER@
WorkingDirectory=~
ExecStartPre=-+/usr/bin/plymouth quit --retain-splash
ExecStopPost=-+/usr/bin/plymouth quit
# the script started by the shell, which reads it: SELinux (Fedora) lets systemd start no file in a home directory
ExecStart=/bin/sh @KINO@/kino
Restart=always
RestartSec=3
# a Chromium hung after a crash does not hold a restart for systemd's 90 seconds
TimeoutStopSec=20

# Own login session on tty1 so cage gets the display and PipeWire gets the audio device
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kino
UtmpIdentifier=tty1
UtmpMode=user

# Hardening: if Chromium or mpv were ever exploited, the rest of the system stays out of reach.
# The system is read-only (the home directory, with Matinee's config and caches, stays writable),
# no privilege gain via setuid, no kernel tuning or modules. Not used on purpose: PrivateDevices
# (graphics and input), MemoryDenyWriteExecute (JavaScript JIT), RestrictNamespaces (Chromium's sandbox).
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run/user
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical.target
