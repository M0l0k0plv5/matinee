#!/bin/sh
# Run all tests, several at once:    tests/run
# Run some modules, several at once: tests/run test_player test_tv
# Run all tests one after another:   tests/run --serial
# Run modules one after another, each test named as it runs:  tests/run --serial test_player
# Run one class or one test:         tests/run test_player.PlayerFastTest
# Also against the real server (read-only):  KINO_REAL=1 tests/run
cd "$(dirname "$0")" || exit 1
if [ "$1" = "--serial" ]; then
  shift
  if [ $# -eq 0 ]; then
    exec python3 -W ignore::ResourceWarning -m unittest discover -s . -p 'test_*.py' -v
  fi
  exec python3 -W ignore::ResourceWarning -m unittest -v "$@"
fi
for arg in "$@"; do
  case "$arg" in
    *.*|-*) exec python3 -W ignore::ResourceWarning -m unittest -v "$@" ;;  # a class, a test or unittest's own options
  esac
done
exec python3 parallel.py "$@"
