#!/usr/bin/env python3
"""Stand-in for wlr-randr in the tests: one 4K screen on HDMI 1.4 (FAKE_RANDR_STATE, a JSON file that
keeps the current mode). --json lists it, --output … --mode WxH@RHz switches; every call goes to FAKE_RANDR_LOG."""
import json
import os
import sys

state = os.environ["FAKE_RANDR_STATE"]
with open(os.environ["FAKE_RANDR_LOG"], "a") as f:
    f.write(json.dumps(sys.argv[1:]) + "\n")
if not os.path.exists(state):
    modes = [(3840, 2160, 30.0), (3840, 2160, 24.0), (2560, 1440, 59.951), (1920, 1080, 120.0),
             (1920, 1080, 119.88), (1920, 1080, 60.0), (1920, 1080, 50.0), (1920, 1080, 23.976),
             (1280, 720, 60.0), (720, 480, 59.94)]
    out = [{"name": "HDMI-A-1", "enabled": True, "modes": [
        {"width": w, "height": h, "refresh": r, "preferred": False, "current": i == 0} for i, (w, h, r) in enumerate(modes)]}]
    with open(state, "w") as f:
        json.dump(out, f)
with open(state) as f:
    outputs = json.load(f)
if "--json" in sys.argv:
    print(json.dumps(outputs))
elif "--mode" in sys.argv:
    size, _, hz = sys.argv[sys.argv.index("--mode") + 1].removesuffix("Hz").partition("@")
    w, h = map(int, size.split("x"))
    for m in outputs[0]["modes"]:
        m["current"] = (m["width"], m["height"]) == (w, h) and abs(m["refresh"] - float(hz)) < 0.01
    with open(state, "w") as f:
        json.dump(outputs, f)
